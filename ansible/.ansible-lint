---
# k3s.orchestration.site is imported via FQCN from a git-sourced collection
# (see requirements.yml). ansible-lint's syntax-check treats role/task files
# resolved from outside the project directory as unreachable and fails to
# load the playbook, even though `ansible-playbook --syntax-check` and real
# runs succeed. Exclude this thin import wrapper until upstream resolves
# https://github.com/ansible/ansible-lint (FQCN import_playbook syntax-check
# false positive for non-vendored collections).
exclude_paths:
  - playbooks/k3s_install.yml
  - .cache/
