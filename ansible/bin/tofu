#!/usr/bin/env bash
# Wrapper so the cloud.terraform.terraform_state ansible inventory plugin can
# invoke the mise-managed `tofu` binary from inside its own temporary working
# directory (which has no mise.toml, so a mise shim can't otherwise resolve a
# version there). `mise exec opentofu@<version>` pins the version explicitly
# so it works regardless of cwd -- unlike `mise exec -C <dir>`, which would
# also change the *command's* cwd away from the plugin's temp dir and break
# `tofu init`/`show` there. Keep this version in sync with mise.toml's
# `opentofu` pin.
set -euo pipefail
exec mise exec opentofu@1.12 -- tofu "$@"
