---
# Single cluster-wide Gateway, shared by every app namespace's HTTPRoutes via
# allowedRoutes.namespaces.from: All — Gateway API's intended split between
# infra (this Gateway, owned by whoever runs Traefik) and app teams (their
# own namespace's HTTPRoutes, attaching across the namespace boundary).
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: traefik-gateway
  namespace: kube-system
spec:
  gatewayClassName: traefik
  listeners:
    - name: web
      # Traefik's internal "web" entryPoint container port. MetalLB fronts
      # the Service on 80/443 externally; this is unrelated and unchanged.
      port: 8000
      protocol: HTTP
      allowedRoutes:
        namespaces:
          from: All
