---
# Dropped into k3s's kubelet static-pod directory so kube-vip starts before
# the apiserver, giving the VIP a chance to exist by the time the first
# server bootstraps. kube-vip will crashloop briefly on that first boot until
# {{ k3s_kubeconfig_path }} exists (k3s hasn't written it yet) — expected,
# and it recovers on its own once k3s comes up and starts leader election.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args:
        - manager
      env:
        - name: vip_arp
          value: "true"
        - name: port
          value: "6443"
        - name: vip_interface
          value: "{{ ansible_default_ipv4.interface }}"
        - name: vip_cidr
          value: "32"
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: kube-system
        - name: vip_ddns
          value: "false"
        - name: svc_enable
          value: "false"
        - name: vip_leaderelection
          value: "true"
        - name: vip_leaseduration
          value: "5"
        - name: vip_renewdeadline
          value: "3"
        - name: vip_retryperiod
          value: "1"
        - name: address
          value: "{{ k3s_apiserver_vip }}"
      securityContext:
        capabilities:
          add:
            - NET_ADMIN
            - NET_RAW
      volumeMounts:
        # kube-vip's manager binary looks for its kubeconfig at this fixed
        # in-container path regardless of where it lives on the host (see
        # kube-vip's own static-pod docs and Helm chart values.yaml, both of
        # which map the k3s kubeconfig here rather than to its host path).
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
  hostAliases:
    - hostnames:
        - kubernetes
      ip: 127.0.0.1
  hostNetwork: true
  volumes:
    - hostPath:
        path: "{{ k3s_kubeconfig_path }}"
        # File (not FileOrCreate): if the container runtime materialized a
        # directory here before k3s writes its real kubeconfig, k3s's later
        # write to this path would fail with EISDIR. Typed as File so the
        # mount fails/retries instead until the real file exists, matching
        # the "crashloops until k3s writes it, then recovers" behavior above.
        type: File
      name: kubeconfig
